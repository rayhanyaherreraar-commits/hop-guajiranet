<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>brg_contrato_plan</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description>Fase 2 Silver definitivo. Dual-run: no reemplaza pipelines viejos. Carga solo staging.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/24 16:40:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/24 16:40:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Table input</from>
      <to>String operations</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>String operations</from>
      <to>PostgreSQL Bulk Loader</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>aws_rds</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    c.sk_contrato,
    p.sk_plan,
    c.idcontrato,
    t.datajson-&gt;&gt;'plan_id' AS id_plan,
    CURRENT_TIMESTAMP AS fecha_actualizacion
FROM bronze_guajiranet.tmjsoncontract t
INNER JOIN silver_guajiranet.tbl_dim_contrato c
        ON t.datajson-&gt;&gt;'id' = c.idcontrato
INNER JOIN silver_guajiranet.tbl_dim_plan p
        ON t.datajson-&gt;&gt;'plan_id' = p.id_plan</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>  <transform>
    <name>String operations</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>idcontrato</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>id_plan</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>  <transform>
    <name>PostgreSQL Bulk Loader</name>
    <type>PGBulkLoader</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>aws_rds</connection>
    <db_override/>
    <delimiter>;</delimiter>
    <enclosure>"</enclosure>
    <load_action>TRUNCATE</load_action>
    <mapping>
      <date_mask></date_mask>
      <field_name>sk_contrato</field_name>
      <stream_name>sk_contrato</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>sk_plan</field_name>
      <stream_name>sk_plan</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>idcontrato</field_name>
      <stream_name>idcontrato</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>id_plan</field_name>
      <stream_name>id_plan</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>fecha_actualizacion</field_name>
      <stream_name>fecha_actualizacion</stream_name>
    </mapping>
    <schema>silver_guajiranet</schema>
    <stop_on_error>N</stop_on_error>
    <table>stg_brg_contrato_plan</table>
    <attributes/>
    <GUI>
      <xloc>832</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>