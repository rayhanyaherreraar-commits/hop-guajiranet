    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>cir</field_name>
      <stream_name>cir</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>precio</field_name>
      <stream_name>precio</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>frequency_in_months</field_name>
      <stream_name>frequency_in_months</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>contracts_count</field_name>
      <stream_name>contracts_count</stream_name>
    </mapping>
    <mapping>
      <date_mask>TIMESTAMP</date_mask>
      <field_name>created_at</field_name>
      <stream_name>created_at</stream_name>
    </mapping>
    <mapping>
      <date_mask>TIMESTAMP</date_mask>
      <field_name>updated_at</field_name>
      <stream_name>updated_at</stream_name>
    </mapping>
    <mapping>
      <date_mask></date_mask>
      <field_name>fecha_actualizacion</field_name>
      <stream_name>fecha_actualizacion</stream_name>
    </mapping>
    <schema>silver_guajiranet</schema>
    <stop_on_error>N</stop_on_error>
    <table>stg_dim_plan</table>
    <attributes/>
