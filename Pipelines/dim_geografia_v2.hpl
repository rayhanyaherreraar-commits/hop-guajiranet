<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_geografia_v2</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description>Fase 2 Silver definitivo. Grano mabarrio.idbarrio. Dual-run: carga stg_dim_geografia_v2. No reemplaza dim_geografia.hpl ni stg_dim_geografia viejo.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/24 16:40:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/24 16:42:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Table input</from>
      <to>String operations</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>String operations</from>
      <to>PostgreSQL Bulk Loader</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>aws_rds</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    0 AS id_barrio,
    'SIN BARRIO' AS barrio,
    CAST(NULL AS character varying(3)) AS dpto,
    CAST(NULL AS character varying(5)) AS mun,
    'SIN MUNICIPIO' AS municipio,
    'SIN DEPARTAMENTO' AS departamento,
    CURRENT_TIMESTAMP AS fecha_actualizacion

UNION ALL

SELECT
    x.id_barrio,
    x.barrio,
    x.dpto,
    x.mun,
    x.municipio,
    x.departamento,
    x.fecha_actualizacion
FROM (
    SELECT DISTINCT ON (b.idbarrio)
        b.idbarrio AS id_barrio,
        b.nombrebarrio AS barrio,
        b.dpto,
        b.mun,
        c.ciudad AS municipio,
        dep.departamento,
        CURRENT_TIMESTAMP AS fecha_actualizacion
    FROM bronze_guajiranet.mabarrio b
    LEFT JOIN bronze_guajiranet.madepartamentos dep
           ON b.dpto = dep.dpto
    LEFT JOIN bronze_guajiranet.maciudades c
           ON b.mun = c.mun
          AND b.dpto = c.dpto
    WHERE b.idbarrio IS DISTINCT FROM 0
    ORDER BY b.idbarrio
) x</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>String operations</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>barrio</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>municipio</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>departamento</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>PostgreSQL Bulk Loader</name>
    <type>PGBulkLoader</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>aws_rds</connection>
    <db_override/>
    <delimiter>;</delimiter>
    <enclosure>"</enclosure>
    <load_action>TRUNCATE</load_action>
    <mapping>
      <date_mask/>
      <field_name>id_barrio</field_name>
      <stream_name>id_barrio</stream_name>
    </mapping>
    <mapping>
      <date_mask/>
      <field_name>barrio</field_name>
      <stream_name>barrio</stream_name>
    </mapping>
    <mapping>
      <date_mask/>
      <field_name>dpto</field_name>
      <stream_name>dpto</stream_name>
    </mapping>
    <mapping>
      <date_mask/>
      <field_name>mun</field_name>
      <stream_name>mun</stream_name>
    </mapping>
    <mapping>
      <date_mask/>
      <field_name>municipio</field_name>
      <stream_name>municipio</stream_name>
    </mapping>
    <mapping>
      <date_mask/>
      <field_name>departamento</field_name>
      <stream_name>departamento</stream_name>
    </mapping>
    <mapping>
      <date_mask/>
      <field_name>fecha_actualizacion</field_name>
      <stream_name>fecha_actualizacion</stream_name>
    </mapping>
    <schema>silver_guajiranet</schema>
    <stop_on_error>N</stop_on_error>
    <table>stg_dim_geografia_v2</table>
    <attributes/>
    <GUI>
      <xloc>832</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
